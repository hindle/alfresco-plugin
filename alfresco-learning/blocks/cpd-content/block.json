{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "alfresco/cpd-content",
	"title": "CPD Content",
	"category": "alfresco",
	"icon": "media-video",
	"description": "CPD content block with a title, description, image, video and file download.",
	"attributes": {
		"title": {
			"type": "string",
			"source": "html",
			"selector": ".cpd-content__title",
			"default": ""
		},
		"description": {
			"type": "string",
			"source": "html",
			"selector": ".cpd-content__description",
			"default": ""
		},
		"imageId": { "type": "number" },
		"imageUrl": {
			"type": "string",
			"source": "attribute",
			"selector": ".cpd-content__image",
			"attribute": "src",
			"default": ""
		},
		"imageAlt": {
			"type": "string",
			"source": "attribute",
			"selector": ".cpd-content__image",
			"attribute": "alt",
			"default": ""
		},
		"videoId": { "type": "string", "default": "" },
		"fileId": { "type": "string", "default": "" }
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css"
}
